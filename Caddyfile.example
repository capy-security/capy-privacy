# Capy Privacy — static Caddyfile (expanded from front/system/etc/caddy/Caddyfile)
#
# Values used:
#   TLS_MODE=on
#   API_SCHEME=https    API_DOMAIN=api.capysecurity.com
#   ADMIN: https://admin.capysecurity.com  (ADMIN_SCHEME was given as admin.capysecurity.com → treated as hostname; scheme https with TLS on)
#   DNS_DOMAIN=dns.capysecurity.com
#   IP_ADDRESS=91.134.137.25
#
# TLS: all certificate paths under /etc/letsencrypt/live/<cert-name>/
# If your IP block cert lives under a different live/ directory name, edit the https://91.134.137.25 block below.

# -----------------------------------------------------------------------------
# API - FastAPI backend
# -----------------------------------------------------------------------------
https://api.capysecurity.com {
	tls /etc/letsencrypt/live/api.capysecurity.com/fullchain.pem /etc/letsencrypt/live/api.capysecurity.com/privkey.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	reverse_proxy capy_api:8080 {
		header_up Host {http.request.host}
		header_up X-Real-IP {http.request.remote.host}
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.scheme}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Port {http.request.port}
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}
}

# -----------------------------------------------------------------------------
# Admin (web UI)
# -----------------------------------------------------------------------------
https://admin.capysecurity.com {
	tls /etc/letsencrypt/live/admin.capysecurity.com/fullchain.pem /etc/letsencrypt/live/admin.capysecurity.com/privkey.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	root * /var/capy/admin

	@static path_regexp .*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|json)$
	handle @static {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

# -----------------------------------------------------------------------------
# DNS - DoH (always HTTPS — required by protocol)
# -----------------------------------------------------------------------------
dns.capysecurity.com {
	tls /etc/letsencrypt/live/dns.capysecurity.com/fullchain.pem /etc/letsencrypt/live/dns.capysecurity.com/privkey.pem

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	root * /var/capy/admin

	handle /dns-query {
		# from doh_proxy_on.conf (TLS_MODE=on)
		reverse_proxy https://capy_core:5300 {
			transport http {
				read_timeout 10s
				write_timeout 10s
				tls_server_name dns.capysecurity.com
			}
		}
	}
}

# -----------------------------------------------------------------------------
# Block page (IP) - HTTP
# -----------------------------------------------------------------------------
http://91.134.137.25 {
	root * /var/capy/blocked
	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
	}
}

# -----------------------------------------------------------------------------
# Block page (IP) - HTTPS (production)
# -----------------------------------------------------------------------------
https://91.134.137.25 {
	tls /etc/letsencrypt/live/91.134.137.25/fullchain.pem /etc/letsencrypt/live/91.134.137.25/privkey.pem

	root * /var/capy/blocked
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}


# -----------------------------------------------------------------------------
# Apex domain (static site on host; capy_front: /var/www/:/var/www/:ro)
# -----------------------------------------------------------------------------

capysecurity.com {
	tls /etc/letsencrypt/live/capysecurity.com/fullchain.pem /etc/letsencrypt/live/capysecurity.com/privkey.pem

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	root * /var/www/

	# Static assets with cache (30d)
	@static path_regexp .*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|json)$
	handle @static {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		file_server
	}

}
def check_prerequisites(*, for_ssl: bool = False) -> None:
    require_cmd("docker", "Install Docker Engine + Compose plugin.")
    # `docker compose` is a plugin; verify it answers.
    try:
        run(["docker", "compose", "version"], capture=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        die("Docker Compose plugin missing. Install docker-compose-plugin.")

    if for_ssl:
        require_cmd("certbot", "Install certbot on this host (Let's Encrypt).")

    if not which("openssl"):
        info("Note: openssl not found (only needed for legacy local TLS scripts).")


def cmd_setup(domain: str | None, ip: str | None) -> None:
    check_prerequisites(for_ssl=False)
    ensure_deploy_layout()

    raw = read_env()
    existing = load_config() if raw else EnvConfig(domain="", ip_address="", api_secret="")

    domain = (domain or raw.get("DOMAIN") or "").strip()
    ip = (ip or raw.get("IP_ADDRESS") or "").strip()

    if not domain:
        entered = input("Server domain [localhost]: ").strip()
        domain = entered or "localhost"

    if domain == "localhost":
        ip = "127.0.0.1"
        info(f"Using IP_ADDRESS={ip} (localhost mode).")
        info(
            "TLS for localhost: use legacy ./capy-init.sh (mkcert). "
            "./capy ssl is certbot-only."
        )
    elif not ip:
        guessed = guess_public_ip()
        entered = input(f"Server IP [{guessed or '?'}]: ").strip()
        ip = entered or guessed
        if not ip:
            die("Could not determine IP; pass --ip or enter the public address.")
        ip = validate_ip(ip)
    else:
        ip = validate_ip(ip)

    api_secret = existing.api_secret or base64.b64encode(
        secrets.token_bytes(32)
    ).decode("ascii")

    cfg = EnvConfig(domain=domain, ip_address=ip, api_secret=api_secret)
    write_env(cfg)

    info("")
    info("Setup complete.")
    info(f"  DOMAIN={cfg.domain}  IP_ADDRESS={cfg.ip_address}")
    info(f"  Deploy dirs ready under {DEPLOY}/")
    info("Next:")
    info("  ./capy ssl          # Let's Encrypt certs (real domain)")
    info("  ./capy build && ./capy up")
    info("  ./capy test")


# ---------------------------------------------------------------------------
# ssl (certbot create / renew)
# ---------------------------------------------------------------------------


def renewal_configs_exist() -> bool:
    renewal = SSL_ROOT / "renewal"
    if not renewal.is_dir():
        return False
    return any(renewal.glob("*.conf"))


def live_cert_ready(hostname: str) -> bool:
    live = SSL_ROOT / "live" / hostname
    return (live / "fullchain.pem").is_file() and (live / "privkey.pem").is_file()


def cmd_ssl(email: str | None) -> None:
    check_prerequisites(for_ssl=True)
    ensure_deploy_layout()
    cfg = load_config()

    if not ENV_FILE.is_file():
        die("No .env found. Run ./capy setup first.")

    if cfg.domain == "localhost":
        die(
            "DOMAIN=localhost cannot use certbot.\n"
            "For local TLS keep using ./capy-init.sh (mkcert)."
        )

    info("Ensure ports 80/443 are free (e.g. ./capy down) before certbot standalone.")
    input("Press Enter to continue...")

    certbot = require_cmd("certbot", "Install certbot.")
    base = [
        certbot,
        "--config-dir",
        str(SSL_ROOT),
        "--work-dir",
        str(SSL_WORK),
        "--logs-dir",
        str(SSL_LOGS),
    ]

    if renewal_configs_exist() and all(live_cert_ready(h) for h in cfg.cert_hostnames):
        info("Existing certbot renewal config detected — renewing.")
        run([*base, "renew", "--standalone", "--non-interactive"])
    else:
        email = (email or "").strip()
        if not email:
            email = input("Let's Encrypt email: ").strip()
        if not email:
            die("Email is required for certbot --agree-tos.")

        info("Requesting new certificates...")
        for name in cfg.cert_hostnames:
            info(f"  certonly -d {name}")
            run(
                [
                    *base,
                    "certonly",
                    "--standalone",
                    "--non-interactive",
                    "--agree-tos",
                    "-m",
                    email,
                    "-d",
                    name,
                ]
            )

    info("")
    info("SSL done.")
    info(f"  Material under {SSL_ROOT}/live/<hostname>/")
    info("  Note: IP block-page cert is not issued here (openssl/legacy).")
    info("  Restart front/core after cert changes: ./capy restart")


# ---------------------------------------------------------------------------
# DNS wire format (stdlib)
# ---------------------------------------------------------------------------


def encode_qname(name: str) -> bytes:
    parts: list[bytes] = []
    for label in name.rstrip(".").split("."):
        raw = label.encode("ascii")
        if not raw or len(raw) > 63:
            raise ValueError(f"Invalid DNS label in {name!r}")
        parts.append(bytes([len(raw)]) + raw)
    return b"".join(parts) + b"\x00"


def build_dns_query(name: str, qtype: int = 1) -> bytes:
    qid = random.randint(1, 65535)
    header = struct.pack("!HHHHHH", qid, 0x0100, 1, 0, 0, 0)
    return header + encode_qname(name) + struct.pack("!HH", qtype, 1)


def _skip_name(data: bytes, pos: int) -> int:
    while pos < len(data):
        length = data[pos]
        if length == 0:
            return pos + 1
        if length & 0xC0 == 0xC0:
            return pos + 2
        pos += 1 + length
    return pos


def parse_a_records(data: bytes) -> list[str]:
    if len(data) < 12:
        return []
    qdcount = struct.unpack_from("!H", data, 4)[0]
    ancount = struct.unpack_from("!H", data, 6)[0]
    pos = 12
    for _ in range(qdcount):
        pos = _skip_name(data, pos)
        pos += 4
    out: list[str] = []
    for _ in range(ancount):
        if pos >= len(data):
            break
        pos = _skip_name(data, pos)
        if pos + 10 > len(data):
            break
        rtype, _, _, rdlen = struct.unpack_from("!HHIH", data, pos)
        pos += 10
        if rtype == 1 and rdlen == 4 and pos + 4 <= len(data):
            out.append(".".join(str(b) for b in data[pos : pos + 4]))
        pos += rdlen
    return out


# ---------------------------------------------------------------------------
# DNS transports
# ---------------------------------------------------------------------------


def dns_udp_query(server: str, name: str, *, port: int = 53, timeout: float = 3.0) -> list[str]:
    query = build_dns_query(name)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.settimeout(timeout)
        sock.sendto(query, (server, port))
        data, _ = sock.recvfrom(4096)
    return parse_a_records(data)


def dns_dot_query(
    server: str,
    name: str,
    *,
    port: int = 853,
    sni: str,
    timeout: float = 5.0,
) -> list[str]:
    query = build_dns_query(name)
    framed = struct.pack("!H", len(query)) + query
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    with socket.create_connection((server, port), timeout=timeout) as raw:
        with ctx.wrap_socket(raw, server_hostname=sni) as tls:
            tls.settimeout(timeout)
            tls.sendall(framed)
            header = _recvexact(tls, 2)
            length = struct.unpack("!H", header)[0]
            data = _recvexact(tls, length)
    return parse_a_records(data)


def _recvexact(sock: ssl.SSLSocket | socket.socket, size: int) -> bytes:
    buf = bytearray()
    while len(buf) < size:
        chunk = sock.recv(size - len(buf))
        if not chunk:
            raise OSError("connection closed while reading DNS message")
        buf.extend(chunk)
    return bytes(buf)


class _HttpsToIp(HTTPSConnection):
    """HTTPSConnection that dials an IP but sends SNI/Host for a hostname."""

    def __init__(self, ip: str, port: int, server_hostname: str, timeout: float):
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        super().__init__(ip, port=port, timeout=timeout, context=context)
        self._server_hostname = server_hostname

    def connect(self) -> None:
        sock = socket.create_connection((self.host, self.port), self.timeout)
        assert self._context is not None
        self.sock = self._context.wrap_socket(
            sock, server_hostname=self._server_hostname
        )


def dns_doh_query(
    server_ip: str,
    name: str,
    *,
    port: int,
    hostname: str,
    path: str = "/dns-query",
    timeout: float = 10.0,
) -> tuple[int, list[str], float]:
    body = build_dns_query(name)
    conn = _HttpsToIp(server_ip, port, hostname, timeout)
    started = time.perf_counter()
    try:
        conn.request(
            "POST",
            path,
            body=body,
            headers={
                "Content-Type": "application/dns-message",
                "Accept": "application/dns-message",
                "Host": hostname,
            },
        )
        resp = conn.getresponse()
        data = resp.read()
        elapsed_ms = (time.perf_counter() - started) * 1000.0
        if resp.status != 200:
            return resp.status, [], elapsed_ms
        return resp.status, parse_a_records(data), elapsed_ms
    finally:
        conn.close()



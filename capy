@dataclass
class EnvConfig:
    domain: str = "localhost"
    ip_address: str = "127.0.0.1"
    api_secret: str = ""

    @property
    def api_domain(self) -> str:
        return f"api.{self.domain}"

    @property
    def admin_domain(self) -> str:
        return f"admin.{self.domain}"

    @property
    def dns_domain(self) -> str:
        return f"dns.{self.domain}"

    @property
    def cert_hostnames(self) -> tuple[str, ...]:
        return (self.api_domain, self.dns_domain, self.admin_domain, self.domain)


def read_env(path: Path = ENV_FILE) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip()
    return values


def load_config() -> EnvConfig:
    raw = read_env()
    return EnvConfig(
        domain=raw.get("DOMAIN", "localhost") or "localhost",
        ip_address=raw.get("IP_ADDRESS", "127.0.0.1") or "127.0.0.1",
        api_secret=raw.get("API_SECRET", ""),
    )


def write_env(cfg: EnvConfig) -> None:
    content = (
        "# Generated by ./capy setup\n"
        f"DOMAIN={cfg.domain}\n"
        f"IP_ADDRESS={cfg.ip_address}\n"
        f"API_SECRET={cfg.api_secret}\n"
    )
    ENV_FILE.write_text(content, encoding="utf-8")
    info(f"Wrote {ENV_FILE}")


def guess_public_ip() -> str:
    try:
        with urllib.request.urlopen("https://api.ipify.org", timeout=3) as resp:
            return resp.read().decode("ascii").strip()
    except (urllib.error.URLError, TimeoutError, OSError):
        pass
    try:
        hostname = socket.gethostname()
        return socket.gethostbyname(hostname)
    except OSError:
        return ""


def validate_ip(value: str) -> str:
    try:
        return str(ipaddress.ip_address(value.strip()))
    except ValueError as exc:
        die(f"Invalid IP address: {value!r} ({exc})")



# test
# ---------------------------------------------------------------------------


@dataclass
class CheckCounters:
    ok: int = 0
    fail: int = 0

    def add(self, passed: bool) -> None:
        if passed:
            self.ok += 1
        else:
            self.fail += 1


@dataclass
class PerfRow:
    label: str
    domain: str
    ok_count: int
    fail_count: int | str
    stats: str
    cached_ms: str


@dataclass
class TestReport:
    recursor: CheckCounters = field(default_factory=CheckCounters)
    doh_443: CheckCounters = field(default_factory=CheckCounters)
    doh_5300: CheckCounters = field(default_factory=CheckCounters)
    dot: CheckCounters = field(default_factory=CheckCounters)
    ports_ok: bool = True
    perf: list[PerfRow] = field(default_factory=list)


def _eval_answer(domain: str, ips: list[str]) -> tuple[bool, str]:
    if not ips:
        return False, "no answer or timeout"
    joined = " ".join(ips)
    if domain == FILTER_DOMAIN:
        if FILTER_EXPECTED_IP in ips:
            return True, f"{joined} (filtering)"
        return False, f"{joined} (expected {FILTER_EXPECTED_IP} for filtering)"
    return True, joined


def check_tcp_port(host: str, port: int, timeout: float = 2.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def run_port_checks(ip: str) -> bool:
    info("")
    info("Port reachability (TCP)")
    all_ok = True
    for port, label in ((80, "HTTP"), (443, "HTTPS"), (853, "DoT")):
        ok = check_tcp_port(ip, port)
        status = "OK  " if ok else "FAIL"
        info(f"  {status}  {ip}:{port} ({label})")
        all_ok = all_ok and ok
    # UDP/53 is validated by the recursor functional checks below.
    info("  note  :53/udp checked via DNS queries")
    return all_ok


def run_udp_checks(ip: str, counters: CheckCounters) -> None:
    info("")
    info("Recursor (plain DNS :53)")
    for domain in TEST_DOMAINS:
        try:
            ips = dns_udp_query(ip, domain)
            passed, detail = _eval_answer(domain, ips)
        except OSError as exc:
            passed, detail = False, str(exc)
        counters.add(passed)
        info(f"  {'OK  ' if passed else 'FAIL'} {domain} -> {detail}")
    info(f"  Recursor: {counters.ok} passed, {counters.fail} failed")


def run_doh_checks(
    ip: str,
    dns_hostname: str,
    port: int,
    title: str,
    counters: CheckCounters,
) -> None:
    info("")
    info(title)
    for domain in TEST_DOMAINS:
        try:
            status, ips, _ = dns_doh_query(
                ip, domain, port=port, hostname=dns_hostname
            )
            if status != 200:
                passed, detail = False, f"HTTP {status}"
            else:
                passed, detail = _eval_answer(domain, ips)
        except OSError as exc:
            passed, detail = False, str(exc)
        counters.add(passed)
        info(f"  {'OK  ' if passed else 'FAIL'} {domain} -> {detail}")
    info(f"  DoH: {counters.ok} passed, {counters.fail} failed")


def run_dot_checks(ip: str, sni: str, counters: CheckCounters) -> None:
    info("")
    info("dnsdist DoT (:853)")
    for domain in TEST_DOMAINS:
        try:
            ips = dns_dot_query(ip, domain, sni=sni)
            passed, detail = _eval_answer(domain, ips)
        except OSError as exc:
            passed, detail = False, str(exc)
        counters.add(passed)
        info(f"  {'OK  ' if passed else 'FAIL'} {domain} -> {detail}")
    info(f"  DoT: {counters.ok} passed, {counters.fail} failed")


def _stats(samples: list[float]) -> str:
    if not samples:
        return "n=0 min=- avg=- max=- last=-"
    return (
        f"n={len(samples)} min={min(samples):.1f} avg={sum(samples)/len(samples):.1f} "
        f"max={max(samples):.1f} last={samples[-1]:.1f}"
    )


def run_perf(
    label: str,
    domain: str,
    samples: int,
    query_ms: Callable[[str], float | None],
) -> PerfRow:
    info("")
    info(f"Performance: {label} ({samples} samples on {domain})")
    ok_samples: list[float] = []
    fails = 0
    for i in range(1, samples + 1):
        ms = query_ms(domain)
        if ms is None:
            fails += 1
            info(f"  sample {i:2d}: FAIL")
        else:
            ok_samples.append(ms)
            info(f"  sample {i:2d}: {ms:.1f} ms")
    cached = query_ms(domain)
    cached_s = f"{cached:.1f}" if cached is not None else "-"
    return PerfRow(
        label=label,
        domain=domain,
        ok_count=len(ok_samples),
        fail_count=fails,
        stats=_stats(ok_samples),
        cached_ms=cached_s,
    )


def cmd_test(
    domain: str | None,
    ip: str | None,
    *,
    run_perf_flag: bool,
    perf_samples: int,
) -> None:
    cfg = load_config()
    domain = (domain or cfg.domain).strip()
    ip = validate_ip(ip or cfg.ip_address)
    dns_host = f"dns.{domain}"

    info(f"Using DOMAIN={domain} IP_ADDRESS={ip}")
    if run_perf_flag:
        info(f"Perf: {perf_samples} samples on {PERF_DOMAIN} per protocol")
    info("---")

    report = TestReport()
    report.ports_ok = run_port_checks(ip)
    run_udp_checks(ip, report.recursor)
    run_doh_checks(
        ip,
        dns_host,
        443,
        f"dnsdist DoH via Caddy (POST https://{dns_host}/dns-query)",
        report.doh_443,
    )
    run_doh_checks(
        ip,
        dns_host,
        5300,
        f"dnsdist DoH direct (POST https://{dns_host}:5300/dns-query)",
        report.doh_5300,
    )
    run_dot_checks(ip, dns_host, report.dot)

    if run_perf_flag:

        def udp_ms(name: str) -> float | None:
            started = time.perf_counter()
            try:
                ips = dns_udp_query(ip, name)
            except OSError:
                return None
            if not ips:
                return None
            return (time.perf_counter() - started) * 1000.0

        def doh_ms(port: int) -> Callable[[str], float | None]:
            def _inner(name: str) -> float | None:
                try:
                    status, ips, elapsed = dns_doh_query(
                        ip, name, port=port, hostname=dns_host
                    )
                except OSError:
                    return None
                if status != 200 or not ips:
                    return None
                return elapsed

            return _inner

        def dot_ms(name: str) -> float | None:
            started = time.perf_counter()
            try:
                ips = dns_dot_query(ip, name, sni=dns_host)
            except OSError:
                return None
            if not ips:
                return None
            return (time.perf_counter() - started) * 1000.0

        report.perf.append(run_perf("UDP :53", PERF_DOMAIN, perf_samples, udp_ms))
        report.perf.append(
            run_perf("DoH :443", PERF_DOMAIN, perf_samples, doh_ms(443))
        )
        report.perf.append(
            run_perf("DoH :5300", PERF_DOMAIN, perf_samples, doh_ms(5300))
        )
        report.perf.append(run_perf("DoT :853", PERF_DOMAIN, perf_samples, dot_ms))

    info("")
    info("=== Summary ===")
    info("Functional checks:")
    info(f"  Recursor :53  {report.recursor.ok} passed, {report.recursor.fail} failed")
    info(f"  DoH :443  {report.doh_443.ok} passed, {report.doh_443.fail} failed")
    info(f"  DoH :5300 {report.doh_5300.ok} passed, {report.doh_5300.fail} failed")
    info(f"  DoT      :853 {report.dot.ok} passed, {report.dot.fail} failed")
    info(f"  Ports TCP     {'OK' if report.ports_ok else 'FAIL'}")

    if run_perf_flag:
        info("")
        info(f"Performance ({perf_samples} samples on {PERF_DOMAIN}, server {ip}):")
        info(
            f"  {'Protocol':<10}  {'Domain':<14}  {'OK/Fail':<7}  "
            f"{'min(ms)':<8}  {'avg(ms)':<8}  {'max(ms)':<8}  {'last(ms)':<8}  {'repeat(ms)'}"
        )
        for row in report.perf:
            # stats: n=X min=Y avg=Z max=A last=B
            parts = dict(
                item.split("=", 1) for item in row.stats.split() if "=" in item
            )
            info(
                f"  {row.label:<10}  {row.domain:<14}  "
                f"{row.ok_count}/{row.fail_count:<5}  "
                f"{parts.get('min', '-'):<8}  {parts.get('avg', '-'):<8}  "
                f"{parts.get('max', '-'):<8}  {parts.get('last', '-'):<8}  "
                f"{row.cached_ms}"
            )

    total_fail = (
        report.recursor.fail
        + report.doh_443.fail
        + report.doh_5300.fail
        + report.dot.fail
        + (0 if report.ports_ok else 1)
    )
    info("")
    if total_fail == 0:
        info("All checks passed.")
        raise SystemExit(0)
    info(
        "Some checks failed "
        f"(recursor: {report.recursor.fail}, DoH :443: {report.doh_443.fail}, "
        f"DoH :5300: {report.doh_5300.fail}, DoT: {report.dot.fail}, "
        f"ports: {'ok' if report.ports_ok else 'fail'})."
    )
    raise SystemExit(1)


# ---------------------------------------------------------------------------
# docker compose
# ---------------------------------------------------------------------------


def compose(args: Sequence[str]) -> None:
    check_prerequisites(for_ssl=False)
    argv = ["docker", "compose", *args]
    info(f"+ {' '.join(argv)}")
    try:
        run(argv)
    except subprocess.CalledProcessError as exc:
        die(
            f"docker compose failed (exit {exc.returncode}). "
            "If this is a permission error, retry with: sudo ./capy …",
            code=exc.returncode or 1,
        )


def cmd_build() -> None:
    compose(["build"])


def cmd_up() -> None:
    compose(["up", "-d", "--build"])


def cmd_down() -> None:
    compose(["down"])


def cmd_restart() -> None:
    compose(["restart"])


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="capy",
        description="Capy Privacy host CLI (setup, SSL, test, compose).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_setup = sub.add_parser("setup", help="Prerequisites + .env + deploy/ layout")
    p_setup.add_argument("--domain", help="Base domain (e.g. example.com)")
    p_setup.add_argument("--ip", help="Public IPv4 address")

    p_ssl = sub.add_parser("ssl", help="Create or renew Let's Encrypt certs (certbot)")
    p_ssl.add_argument("--email", help="Let's Encrypt account email (new certs)")

    p_test = sub.add_parser("test", help="Port + DNS functional/perf checks")
    p_test.add_argument("--domain", help="Override DOMAIN from .env")
    p_test.add_argument("--ip", help="Override IP_ADDRESS from .env")
    p_test.add_argument("--no-perf", action="store_true", help="Skip latency benchmarks")
    p_test.add_argument(
        "--perf",
        type=int,
        nargs="?",
        const=DEFAULT_PERF_SAMPLES,
        default=DEFAULT_PERF_SAMPLES,
        metavar="N",
        help=f"Latency samples per protocol (default: {DEFAULT_PERF_SAMPLES})",
    )

    sub.add_parser("build", help="docker compose build")
    sub.add_parser("up", help="docker compose up -d --build")
    sub.add_parser("down", help="docker compose down")
    sub.add_parser("restart", help="docker compose restart")

    return parser


def main(argv: Sequence[str] | None = None) -> None:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "setup":
        cmd_setup(args.domain, args.ip)
    elif args.command == "ssl":
        cmd_ssl(args.email)
    elif args.command == "test":
        cmd_test(
            args.domain,
            args.ip,
            run_perf_flag=not args.no_perf,
            perf_samples=max(args.perf or DEFAULT_PERF_SAMPLES, 1),
        )
    elif args.command == "build":
        cmd_build()
    elif args.command == "up":
        cmd_up()
    elif args.command == "down":
        cmd_down()
    elif args.command == "restart":
        cmd_restart()
    else:
        parser.error(f"Unknown command: {args.command}")


if __name__ == "__main__":
    main()

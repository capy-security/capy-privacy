def ensure_deploy_layout() -> None:
    for path in (
        SSL_ROOT / "live",
        SSL_WORK,
        SSL_LOGS,
        DEPLOY / "database",
        CADDY_CONFD,
        DEPLOY / "www",
        DEPLOY / "dnsdist",
        DEPLOY / "powerdns",
    ):
        path.mkdir(parents=True, exist_ok=True)

    if not DNSDIST_ACL.is_file():
        DNSDIST_ACL.write_text(DNSDIST_ACL_DEFAULT, encoding="utf-8")
    if not POWERDNS_ACL.is_file():
        POWERDNS_ACL.write_text(POWERDNS_ACL_DEFAULT, encoding="utf-8")

    placeholder = CADDY_CONFD / ".gitkeep.caddy"
    if not placeholder.is_file():
        placeholder.write_text(CADDY_PLACEHOLDER, encoding="utf-8")



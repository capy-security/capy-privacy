# Capy Privacy — base reverse proxy (api, admin, dns, block page)
# Domains from container env: DOMAIN, API_DOMAIN, ADMIN_DOMAIN, DNS_DOMAIN, IP_ADDRESS
# TLS under /etc/letsencrypt/live/<name>/ (bind-mount ./ssl in compose)
# Custom vhosts: drop *.caddy files in /etc/caddy/conf.d/ on the host (see caddy-conf.d/apex.caddy.example in repo)

# -----------------------------------------------------------------------------
# API - FastAPI backend
# -----------------------------------------------------------------------------
https://{$API_DOMAIN} {
	tls /etc/letsencrypt/live/{$API_DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$API_DOMAIN}/privkey.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	reverse_proxy capy-api:8080 {
		header_up Host {http.request.host}
		header_up X-Real-IP {http.request.remote.host}
		header_up X-Forwarded-Port {http.request.port}
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}
}

# -----------------------------------------------------------------------------
# Admin (web UI)
# -----------------------------------------------------------------------------
https://{$ADMIN_DOMAIN} {
	tls /etc/letsencrypt/live/{$ADMIN_DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$ADMIN_DOMAIN}/privkey.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	root * /var/capy/admin

	@static path_regexp .*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|json)$
	handle @static {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

# -----------------------------------------------------------------------------
# DNS - DoH (always HTTPS — required by protocol)
# -----------------------------------------------------------------------------
{$DNS_DOMAIN} {
	tls /etc/letsencrypt/live/{$DNS_DOMAIN}/fullchain.pem /etc/letsencrypt/live/{$DNS_DOMAIN}/privkey.pem

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	root * /var/capy/admin

	handle /dns-query {
		reverse_proxy https://{$CORE_HOST}:5300 {
			transport http {
				read_timeout 10s
				write_timeout 10s
				tls_server_name {$DNS_DOMAIN}
			}
		}
	}
}

# -----------------------------------------------------------------------------
# Block page (IP) - HTTP
# -----------------------------------------------------------------------------
http://{$IP_ADDRESS} {
	root * /var/capy/blocked
	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
	}
}

# -----------------------------------------------------------------------------
# Block page (IP) - HTTPS
# -----------------------------------------------------------------------------
https://{$IP_ADDRESS} {
	tls /etc/letsencrypt/live/{$IP_ADDRESS}/fullchain.pem /etc/letsencrypt/live/{$IP_ADDRESS}/privkey.pem

	root * /var/capy/blocked
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# -----------------------------------------------------------------------------
# User custom vhosts — host /etc/caddy/conf.d/*.caddy (mounted as container conf.d/)
# -----------------------------------------------------------------------------
import conf.d/*.caddy
